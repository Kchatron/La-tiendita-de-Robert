rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isPrimaryAdmin() {
      return request.auth != null
        && request.auth.uid == 'NSKN8zAaBpXmvgPPS5fWAZm8XeF2';
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /books/{bookId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isPrimaryAdmin()
        || (request.auth != null
          && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && (
            request.resource.data.status == resource.data.status
            || (resource.data.status == 'rejected'
              && request.resource.data.status == 'pending')
          ));

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if request.auth != null
          && (resource.data.userId == request.auth.uid || isPrimaryAdmin());
      }
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isPrimaryAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isPrimaryAdmin();
      allow create: if isOwner(userId)
        && (request.resource.data.role == 'user' || isPrimaryAdmin());
      allow update: if isOwner(userId)
        && (request.resource.data.role == resource.data.role || isPrimaryAdmin());
      allow delete: if isPrimaryAdmin();

      match /favorites/{favoriteId} {
        allow read, write: if isOwner(userId);
      }

      match /library/{libraryId} {
        allow read, write: if isOwner(userId);
      }

      match /purchases/{purchaseId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /_migrations/{migrationId} {
      allow read: if isPrimaryAdmin();
      allow write: if false;
    }
  }
}
